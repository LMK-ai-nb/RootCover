{
  "version": 1,
  "mode": "feasibility",
  "variables": ["offset", "gain"],
  "constraints": [
    {"expression": "sin((offset-1000000)/1000)+1000*gain", "range": [0.58, 0.62]},
    {"expression": "exp(1000*gain)", "range": [1.6, 1.7]}
  ],
  "box": [[1000000, 1000200], [0, 0.002]],
  "search": {"strategy": "bfs", "split": "scaled", "absolute_tolerances": [0.05, 0.000005], "relative_tolerance": 0.000001},
  "options": {"tolerance": 0.00001, "max_assessments": 12000}
}
